# --- scrum-service environment ---

# Read-only Postgres connection to the scrum database.
# (Same value as the OpenClaw scrummaster agent's SCRUM_POSTGRESQL_PUBLIC_URL.)
SCRUM_POSTGRESQL_PUBLIC_URL=postgresql://user:pass@host:5432/dbname

# Shared secret OpenClaw must send as `Authorization: Bearer <key>` to call /mcp.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Optional. Where change-check persists table counts between calls.
# Defaults to /data/scrum-service/state.json (attach a Railway volume at /data to persist).
# SCRUM_STATE_PATH=/data/scrum-service/state.json

# Railway injects PORT automatically; only set this for local runs.
# PORT=3000
